# Copy this file to `.env` and customize for your Google Cloud environment
GOOGLE_CLOUD_ACCOUNT=your-account@example.com
GOOGLE_CLOUD_PROJECT=your-gcp-project
CLOUD_RUN_REGION=europe-west1
CLOUD_RUN_SERVICE=your-service-name
CLOUD_RUN_DOMAIN=your-domain.example.com
CLOUD_RUN_BASE_IMAGE=google-24/java25
CLOUD_RUN_MEMORY=2Gi
CLOUD_RUN_CPU=2
CLOUD_RUN_SECRET=GEMINI_API_KEY=GEMINI_API_KEY:latest
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_CONCURRENCY=20
